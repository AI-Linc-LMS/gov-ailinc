# Windows reserved filename — ignore to avoid git add errors
/CON

# package-lock.json IS committed here (the upstream app ignores it).
# This repo is handed to prospects and rebuilt on Netlify months apart; an
# unpinned tree means a transitive release can break a live sales demo with no
# code change on our side.

# Playwright
/playwright-report/
/test-results/
e2e/.auth/


# macOS custom folder icon: a file literally named "Icon" followed by a CR.
#
# ROOT-ANCHORED deliberately. Unanchored, `Icon?` matches at every level, and
# git on macOS is case-insensitive by default — so it also matched the directory
# `lib/demo/icons/`, silently excluding the committed icon bundle. The Netlify
# build then failed on an import of a file that existed locally and had never
# been pushed. Keep the leading slash.
/Icon?
.gstack/

# Generated by scripts/copy-monaco.mjs (see prebuild); not vendored.
/public/monaco/

# Per-process scratch from scripts/verify-curriculum.mjs and scripts/verify-catalogue.mjs.
# Suffixed with the pid so parallel authors do not clobber each other, hence the glob.
/.curriculum-check-*
/.catalogue-check-*
