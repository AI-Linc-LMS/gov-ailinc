# @tiptap/extension-image pins a @tiptap/core older than the one @tiptap/starter-kit
# resolves, so npm refuses to install the tree at all without this. The conflict is
# inherited from the upstream app and is unrelated to demo mode; the upstream CI
# passes --legacy-peer-deps for exactly the same reason.
#
# Setting it here rather than expecting a flag means `git clone && npm install`
# just works — which matters for a repo whose whole job is being easy to hand over.
legacy-peer-deps=true
