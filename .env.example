# gov-ailinc needs no environment file. Clone it, install, run.
#
# Demo mode is on unless you switch it off, the tenant id is pinned in
# lib/demo/config.ts, and every request is answered in the browser, so there is
# no API base URL to point at and no client id to match. Copy this file to
# ".env.local" only if you want one of the two settings below.

# --- The only two keys that do anything in this build ---

# Absolute URL of the deployment. Sets Next's metadataBase, which is what makes
# Open Graph and credential-share images resolve to absolute URLs. Leave empty
# for local work; on Netlify set it to the site URL.
NEXT_PUBLIC_APP_URL=

# Set to "false" to turn the in-browser backend OFF and make the app talk to a
# real API again. That is a debugging affordance for comparing against the
# production frontend, not a supported deployment: with demo mode off this build
# has no data at all until NEXT_PUBLIC_API_BASE_URL and NEXT_PUBLIC_CLIENT_ID
# below point at a live LMS backend.
# NEXT_PUBLIC_DEMO_MODE=false

# --- Inherited from the production frontend, inert while demo mode is on ---
# Documented so the diff against upstream stays readable, not because this build
# reads them.

# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_CLIENT_ID=101
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_LIVEKIT_URL=
# NEXT_PUBLIC_OTEL_SERVICE_NAME=lms-platform-frontend
# NEXT_PUBLIC_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# NEXT_PUBLIC_OTEL_DEBUG=false

# --- Server-only API routes (never expose secrets with NEXT_PUBLIC_) ---
# Optional, and left unset on purpose: the demo has to run offline. Without a key
# the routes under app/api/ that use it degrade rather than fail. The resume ATS
# check falls back to the local analyser in app/api/ats-analyze/localAnalysis.ts,
# and article narration falls back to the browser speech voice on a 503.
# OPENAI_API_KEY=
# OPENAI_ATS_MODEL=gpt-4o-mini
# OPENAI_WHISPER_MODEL=whisper-1
